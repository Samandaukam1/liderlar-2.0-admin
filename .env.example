# Public Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase value
SUPABASE_SERVICE_ROLE_KEY=

# AdabiyotX catalog integration (server-only, brauzerga chiqmaydi)
ADABIYOTX_API_BASE_URL=https://adabiyotx.uz
ADABIYOTX_CATALOG_SEARCH_PATH=/api/public/catalog/search
# AdabiyotX bergan maxfiy kalit, x-adabiyotx-api-key header'ida yuboriladi
ADABIYOTX_INTEGRATION_API_KEY=

# Optional: protects the cross-project public content endpoint when set
LIDERLAR_PUBLIC_CONTENT_API_KEY=

# ---------- Post Studio ----------
# Portret fonini olib tashlash o'z serverimizda ishlaydi (models/silueta.onnx,
# ONNX Runtime, CPU). Hech qanday tashqi API kaliti kerak emas: model repo
# ichida, shuning uchun bu bo'limda sozlanadigan qiymat yo'q.

# ---------- Telegram yetkazib beruvchi bot ----------
# Bot HECH QANDAY kanalga admin qilinmaydi. Foydalanuvchilar /start orqali
# obuna bo'ladi, postlar shaxsiy chatga yuboriladi. TELEGRAM_CHANNEL_ID KERAK EMAS.
TELEGRAM_BOT_TOKEN=
# setWebhook'da secret_token sifatida beriladi; webhook shu header'ni tekshiradi.
TELEGRAM_WEBHOOK_SECRET=
# Caption'dagi @username uchun (site_settings 'telegram_bot.username' ustun turadi)
TELEGRAM_BOT_USERNAME=
# Caption havolalari (site_settings qiymatlari ustun turadi)
NEXT_PUBLIC_APPLICATION_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Vercel Cron 2 soatlik pipeline'ni himoyalaydi
CRON_SECRET=
