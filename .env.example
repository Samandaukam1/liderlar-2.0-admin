# Public Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase value
SUPABASE_SERVICE_ROLE_KEY=

# AdabiyotX catalog integration (server-only, brauzerga chiqmaydi)
ADABIYOTX_API_BASE_URL=https://adabiyotx.uz
ADABIYOTX_CATALOG_SEARCH_PATH=/api/public/catalog/search
# AdabiyotX bergan maxfiy kalit, x-adabiyotx-api-key header'ida yuboriladi
ADABIYOTX_INTEGRATION_API_KEY=

# Optional: protects the cross-project public content endpoint when set
LIDERLAR_PUBLIC_CONTENT_API_KEY=
